# Copy to .env.local and adjust. All values are optional.

# auto      = explicitly allow sample fallback if generated services are missing
# sample    = always use built-in sample data
# dataverse = require the Dataverse virtual tables (fails with a clear message if they're missing)
VITE_RFQ_DATA_MODE=dataverse

# Optional initial selection. Users can switch legal entity in the app.
VITE_FNO_COMPANY=

# Finance & Supply Chain base URL for "Open in F&SC" links, e.g. https://contoso.operations.dynamics.com
VITE_FNO_URL=
